{
  "name": "kayangan-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kayangan Office: a lightweight Three.js office above the clouds with four nonhuman playable characters.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:render": "node qa/render.mjs",
    "qa:route": "node qa/route.mjs",
    "qa:probe": "node qa/pixel-probe.mjs",
    "qa:inspect": "node qa/inspect.mjs"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
